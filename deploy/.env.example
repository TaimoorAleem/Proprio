# Optional overrides for deploy/compose.yaml. Copy to deploy/.env (gitignored).
# Every value shown is the built-in dev-only default; none of them is a secret.

POSTGRES_PASSWORD=proprio-dev-pg
RABBIT_PASSWORD=proprio-dev-mq
S3_ACCESS_KEY=proprio
S3_SECRET_KEY=proprio-dev-s3
S3_BUCKET=proprio-raw

# Host that signs presigned upload URLs: how the CLIENT (E2E suite, a phone) reaches MinIO.
# core-api itself uses http://minio:9000 inside the compose network. For a phone on the LAN:
#   S3_PUBLIC_ENDPOINT=http://192.168.1.20:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Model for inference. Unset: model-init trains the synthetic fixture into a volume.
# Set: a host directory that contains proprio-classifier/ (model.joblib + metadata.json) from
#   python -m proprio_inference.train_model --out <dir>/proprio-classifier
# MODEL_DIR=E:/models

# core-api profile. dev = ephemeral JWT key + swagger. Anything else needs a key:
# CORE_API_PROFILE=prod
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Phone on the LAN: core-api (8080) and MinIO's S3 API (9000) are bound to 127.0.0.1 unless
# PUBLIC_BIND=0.0.0.0. Use it together with S3_PUBLIC_ENDPOINT=http://<pc-lan-ip>:9000, and allow
# both ports through the firewall for the Private profile only. Everything else stays on 127.0.0.1.
# PUBLIC_BIND=0.0.0.0

# Host ports (bound to 127.0.0.1, except core-api and MinIO with PUBLIC_BIND)
# CORE_API_PORT=8080
# INFERENCE_PORT=8000
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# RABBIT_MANAGEMENT_PORT=15672
